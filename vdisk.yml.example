# vdisk.yml.example: plantilla declarativa de vboxdisk. Copie este fichero como
# vdisk.yml (o paselo con vboxdisk apply -f FILE) y declare una maquina por
# clave de primer nivel. Cada maquina necesita vm_user y al menos una
# credencial (vm_pass o vm_pass_file); la lista disks puede venir vacia u
# omitida mientras la maquina no declare ningun disco. Cada disco que se
# declare necesita label, size, fs_type y mount_point, y admite ademas file y
# state.
VM1:
  vm_user: debian
  vm_pass: "cambia-esta-clave"
  # La maquina admite todos los discos de datos que declare bajo 'disks'.
  disks:
    disk1:
      size: 4g                     # 4096 MB
      fs_type: ext4
      mount_point: /mnt/datos
      label: datos-vm1
      # file: ruta/opcional.vdi    # si se omite, el nombre sale del
      #                             # directorio de la vm y de la clave
      # state: active              # active crea y adjunta; inactive desmonta
      #                             # y desprende el disco, sin borrarlo
    disk2:
      size: 1024                   # megabytes enteros, sin sufijo
      fs_type: ext4
      mount_point: /mnt/respaldo
      label: respaldo-vm1
      file: /home/jorge/.mvs/debian/VM1/VM1-respaldo.vdi

VM2:
  vm_user: debian
  # Alternativa a vm_pass: fichero legible solo por el usuario, cuyo contenido
  # es unicamente la contrasena (sin terminador de linea).
  vm_pass_file: /home/jorge/.secrets/vm2.pass
  disks:
    disk1:
      size: 3g
      fs_type: xfs
      mount_point: /srv/datos
      label: datos-vm2
      file: /home/jorge/.mvs/debian/VM2/VM2-datos.vdi
