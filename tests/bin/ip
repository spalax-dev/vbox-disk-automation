# Doble de ip para las pruebas: tabla ARP vacia, sin vecinos que puedan
# corresponder a la direccion MAC del doble de VBoxManage.
if [[ "${1:-}" == "neigh" ]]; then
    # Sin vecinos: la busqueda ARP del respaldo no halla ninguna direccion.
    exit 0
fi
exit 0
