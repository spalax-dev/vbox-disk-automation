# Doble de VBoxManage para las pruebas: cubre list vms, showvminfo
# --machinereadable, guestproperty, createmedium, showmediuminfo,
# modifymedium, storageattach, closemedium y Guest Control (mktemp, copyto y
# run), suficiente para ensayar la
# verificacion declarativa, apply y la consulta en vivo de ld sin una vm
# real. El estado de la maquina se fija con VBOXDISK_MOCK_VMSTATE; sin esa
# variable, startvm lo escribe en <estado>.vmstate para que las consultas
# siguientes lo reflejen (poweroff por defecto). Las pruebas registran la
# lista inicial de discos en VBOXDISK_MOCK_ATTACHED y, si
# declaran VBOXDISK_MOCK_STATE, el doble conserva los adjuntos en ese
# fichero de modo que una adjuncion o un desprendimiento se reflejen en la
# siguiente consulta. Cada invocacion puede quedar ademas anotada en
# VBOXDISK_MOCK_LOG.
if [[ -n "${VBOXDISK_MOCK_LOG:-}" ]]; then
    printf '%s\n' "$*" >>"$VBOXDISK_MOCK_LOG"
fi

# discos_adjuntos: los medios de datos en el orden de sus puertos.
discos_adjuntos() {
    if [[ -n "${VBOXDISK_MOCK_STATE:-}" && -f "${VBOXDISK_MOCK_STATE}" ]]; then
        cat "${VBOXDISK_MOCK_STATE}"
        return 0
    fi
    local d
    for d in ${VBOXDISK_MOCK_ATTACHED:-}; do
        printf '%s\n' "$d"
    done
}

# guardar_adjuntos <lineas...>: persiste la lista cuando hay estado.
guardar_adjuntos() {
    [[ -n "${VBOXDISK_MOCK_STATE:-}" ]] || return 0
    if (($# == 0)); then
        : >"${VBOXDISK_MOCK_STATE}"
        return 0
    fi
    printf '%s\n' "$@" >"${VBOXDISK_MOCK_STATE}"
}

# argumento <bandera> <valor por defecto> <argumentos...>: valor de una
# bandera del doble, admitida tanto como "--bandera valor" como
# "--bandera=valor". Sin la bandera devuelve el valor por defecto.
argumento() {
    local flag="$1" prev=""
    shift
    for arg in "$@"; do
        if [[ "$prev" == "$flag" ]]; then
            printf '%s' "$arg"
            return 0
        fi
        if [[ "$arg" == "$flag="* ]]; then
            printf '%s' "${arg#"$flag="}"
            return 0
        fi
        prev="$arg"
    done
    printf '%s' "$1"
}

case "${1:-}" in
    # Relato de maquinas declaradas: VM1 y VM2 con UUIDs fijos.
    list)
        printf '%s\n' '"VM1" {aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee}'
        printf '%s\n' '"VM2" {11111111-2222-3333-4444-555555555555}'
        ;;
    # Configuracion legible por maquina: apagada, con dos controladores y un
    # controlador SATA que contiene el disco del sistema en el puerto 0. Se
    # replica el formato real de VBoxManage: claves de controlador
    # storagecontroller<campo><indice> (sin comillas) y lineas de adjuncion
    # con la clave entre comillas ("SATA-0-0"="..."). El PortCount vigente
    # vale 1 mas el numero de discos de datos adjuntos, de modo que una
    # adjuncion en un puerto fuera de ese rango exige ampliarlo antes, como
    # en la maquina real. Con VBOXDISK_MOCK_SATA_NONE se publican ademas
    # los puertos 1 y 2 existentes sin medio (valor none) para ensayar que
    # un puerto vacio se cuente como libre.
    showvminfo)
        vm="${2:-}"
        printf 'name="%s"\n' "$vm"
        printf 'CfgFile="/home/jorge/.mvs/debian/%s/%s.vbox"\n' "$vm" "$vm"
        state="${VBOXDISK_MOCK_VMSTATE:-}"
        if [[ -z "$state" && -n "${VBOXDISK_MOCK_STATE:-}" && -f "${VBOXDISK_MOCK_STATE}.vmstate" ]]; then
            state="$(cat "${VBOXDISK_MOCK_STATE}.vmstate")"
        fi
        printf 'VMState="%s"\n' "${state:-poweroff}"
        printf '%s\n' 'macaddress1="080027F2C586"'
        printf '%s\n' 'storagecontrollername0="IDE"'
        printf '%s\n' 'storagecontrollertype0="PIIX4"'
        printf '%s\n' 'storagecontrollermaxportcount0="2"'
        printf '%s\n' 'storagecontrollerportcount0="2"'
        printf '%s\n' 'storagecontrollername1="SATA"'
        printf '%s\n' 'storagecontrollertype1="IntelAhci"'
        printf '%s\n' 'storagecontrollermaxportcount1="30"'
        items=()
        while IFS= read -r line; do
            [[ -n "$line" ]] && items+=("$line")
        done < <(discos_adjuntos)
        if [[ -n "${VBOXDISK_MOCK_SATA_NONE:-}" ]]; then
            printf '%s\n' 'storagecontrollerportcount1="3"'
            printf '%s\n' '"SATA-1-0"="none"'
            printf '%s\n' '"SATA-2-0"="none"'
        else
            printf 'storagecontrollerportcount1="%d"\n' "$((1 + ${#items[@]}))"
        fi
        printf '%s\n' '"SATA-0-0"="/home/jorge/.mvs/debian/VM1/VM1-disk1.qcow"'
        printf '%s\n' '"SATA-ImageUUID-0-0"="11111111-2222-3333-4444-555555555555"'
        port=1
        for medium in "${items[@]}"; do
            printf '"SATA-%d-0"="%s"\n' "$port" "$medium"
            printf '"SATA-ImageUUID-%d-0"="aaaaaaaa-0000-0000-0000-%012d"\n' "$port" "$port"
            port=$((port + 1))
        done
        ;;
    # guestproperty get <vm> <propiedad>: version de Guest Additions cuando
    # la prueba la declara; sin ella responde como el hipervisor real ante
    # una propiedad que nadie publico.
    guestproperty)
        case "${4:-}" in
            /VirtualBox/GuestAdd/Version)
                if [[ -n "${VBOXDISK_MOCK_GA_VERSION:-}" ]]; then
                    printf 'Value: %s\n' "$VBOXDISK_MOCK_GA_VERSION"
                else
                    printf 'No value set!\n'
                fi
                ;;
            /VirtualBox/GuestAdditions/Version)
                if [[ -n "${VBOXDISK_MOCK_GA_VERSION_LEGACY:-}" ]]; then
                    printf 'Value: %s\n' "$VBOXDISK_MOCK_GA_VERSION_LEGACY"
                else
                    printf 'No value set!\n'
                fi
                ;;
            /VirtualBox/GuestInfo/Net/0/V4/IP)
                if [[ -n "${VBOXDISK_MOCK_IP:-}" ]]; then
                    printf 'Value: %s\n' "$VBOXDISK_MOCK_IP"
                else
                    printf 'No value set!\n'
                fi
                ;;
        esac
        ;;
    # createmedium crea el fichero con su capacidad en MB como unico
    # contenido: el doble no almacena binario VDI, pero showmediuminfo y
    # modifymedium leen y escriben esa capacidad para que una ampliacion se
    # ensaye de punta a punta.
    createmedium)
        file="$(argumento --filename "" "${@:2}")"
        size="$(argumento --size "" "${@:2}")"
        if [[ -n "$file" ]]; then
            mkdir -p "$(dirname "$file")"
            if [[ "$size" =~ ^[0-9]+$ ]]; then
                printf '%s\n' "$size" >"$file"
            else
                : >"$file"
            fi
        fi
        ;;
    # showmediuminfo disk <fichero>: capacidad del medio. Sin un fichero
    # legible el hipervisor real termina con error, y asi lo reproduce aqui.
    showmediuminfo)
        medium="${3:-}"
        cap=""
        if [[ -n "$medium" && -f "$medium" ]]; then
            cap="$(head -n1 "$medium" 2>/dev/null || true)"
        fi
        if [[ ! "$cap" =~ ^[0-9]+$ ]]; then
            printf 'VBoxManage: error: Could not find file for the medium "%s" (VERR_FILE_NOT_FOUND)\n' "$medium" >&2
            exit 1
        fi
        printf 'UUID:           11111111-2222-3333-4444-555555555555\n'
        printf 'Storage format: VDI\n'
        printf 'Capacity:       %s MBytes\n' "$cap"
        printf 'Size on disk:   %s MBytes\n' "$cap"
        ;;
    # modifymedium disk <fichero> --resize N: la capacidad nueva queda escrita
    # en el propio fichero; sin fichero o sin tamano numerico, error.
    modifymedium)
        medium="${3:-}"
        size="$(argumento --resize "" "${@:4}")"
        if [[ ! "$size" =~ ^[0-9]+$ ]]; then
            printf 'VBoxManage: error: Argument error: Missing required argument\n' >&2
            exit 1
        fi
        if [[ -z "$medium" || ! -f "$medium" ]]; then
            printf 'VBoxManage: error: Could not find file for the medium "%s" (VERR_FILE_NOT_FOUND)\n' "$medium" >&2
            exit 1
        fi
        printf '%s\n' "$size" >"$medium"
        printf 'Progress state: 100%%\n'
        printf 'Resize complete\n'
        ;;
    # storageattach anade o retira un medio de la lista de adjuntos.
    storageattach)
        medium="$(argumento --medium "" "${@:3}")"
        port="$(argumento --port "0" "${@:3}")"
        items=()
        while IFS= read -r line; do
            [[ -n "$line" ]] && items+=("$line")
        done < <(discos_adjuntos)
        if [[ -z "$medium" || "$medium" == "none" ]]; then
            idx=$((port - 1))
            if ((idx >= 0 && idx < ${#items[@]})); then
                unset 'items[idx]'
            fi
        else
            items+=("$medium")
        fi
        guardar_adjuntos "${items[@]}"
        ;;
    # closemedium retira el medio y, con --delete, borra el fichero.
    closemedium)
        # Invocado como: closemedium disk <fichero> [--delete]
        medium="${3:-}"
        if [[ -n "$medium" && -f "$medium" ]] && printf '%s\n' "${@:4}" | grep -q -- '--delete'; then
            rm -f "$medium"
        fi
        ;;
    # Guest Control: mktemp, copyto y run (sondeo del invitado y limpieza).
    guestcontrol)
        sub=""
        probe=0
        for a in "$@"; do
            case "$a" in
                mktemp | copyto | run) sub="$a" ;;
                --probe) probe=1 ;;
            esac
        done
        case "$sub" in
            mktemp) printf 'Directory name: /tmp/vboxdisk.MOCK0001\n' ;;
            copyto)
                # VBoxManage 7.2 exige la barra final en --target-directory:
                # sin ella toma el destino como fichero y falla contra un
                # directorio existente con ese nombre.
                target="$(argumento --target-directory "" "$@")"
                if [[ "$target" != */ ]]; then
                    printf 'VBoxManage: error: File copy failed\n' >&2
                    printf 'VBoxManage: error: Destination "%s" on the guest already exists and is a directory\n' "${target%/}" >&2
                    exit 1
                fi
                ;;
            run)
                # El anfitrion envia la declaracion del disco con cada
                # invocacion; sin argumentos se responden los valores fijos
                # de las pruebas.
                for a in "$@"; do
                    if [[ "$a" == "--release" ]]; then
                        printf 'VBOXDISK_EXIT=0\n'
                        exit 0
                    fi
                done
                size="$(argumento --size-mb 4096 "$@")"
                mount="$(argumento --mount /mnt/datos "$@")"
                fstype="$(argumento --fstype ext4 "$@")"
                label="$(argumento --label datos-vm1 "$@")"
                if ((probe)); then
                    # VBOXDISK_MOCK_PROBE_EXIT reproduce un disco no
                    # identificable: el script emite su diagnostico y la
                    # centinela con el codigo de salida.
                    if [[ -n "${VBOXDISK_MOCK_PROBE_EXIT:-}" && "${VBOXDISK_MOCK_PROBE_EXIT}" != "0" ]]; then
                        printf 'guest_ensure: no se identifico ningun disco de 4096 MB libre de montajes y sin etiqueta\n'
                        printf 'VBOXDISK_EXIT=%s\n' "$VBOXDISK_MOCK_PROBE_EXIT"
                        exit "$VBOXDISK_MOCK_PROBE_EXIT"
                    fi
                fi
                # Salida del script invitado con claves derivadas de la
                # declaracion, de modo que la verificacion y la deriva
                # concuerden con lo que el anfitrion acaba de declarar.
                printf '%s\n' \
                    'DEVICE=/dev/sdb' \
                    "SIZE_MB=$size" \
                    'TABLE=gpt' \
                    'PART=' \
                    "FSTYPE=$fstype" \
                    'UUID=11111111-2222-3333-4444-555555555555' \
                    'MOUNTED=yes' \
                    "MOUNTPOINT=$mount" \
                    'FSTAB=yes' \
                    "TABLE_LINE=sdb 4.0G $fstype $label $mount" \
                    'VBOXDISK_EXIT=0'
                ;;
        esac
        exit 0
        ;;
    # startvm enciende la maquina: el estado queda en <estado>.vmstate
    # para que las consultas siguientes lo reflejen, como haria el
    # hipervisor con su fichero de configuracion.
    startvm)
        if [[ -n "${VBOXDISK_MOCK_STATE:-}" ]]; then
            printf 'running\n' >"${VBOXDISK_MOCK_STATE}.vmstate"
        fi
        ;;
    # controlvm acpipowerbutton/poweroff apaga la maquina sin esperar los
    # 60 s de vbox_stop: el estado vuelve a poweroff en <estado>.vmstate.
    controlvm)
        sub="${3:-}"
        if [[ -n "${VBOXDISK_MOCK_STATE:-}" ]] &&
            { [[ "$sub" == "acpipowerbutton" ]] || [[ "$sub" == "poweroff" ]]; }; then
            printf 'poweroff\n' >"${VBOXDISK_MOCK_STATE}.vmstate"
        fi
        ;;
    *)
        exit 0
        ;;
esac
