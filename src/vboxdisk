# vboxdisk: punto de entrada. Solo orquesta: localiza y carga las
# bibliotecas, registra la trampa de limpieza, delega el analisis de la
# linea de comandos en cli.sh y despacha la orden recibida a su manejador.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

# Localizacion de las bibliotecas: junto al punto de entrada (repositorio) o
# en las rutas XDG cuando el paquete esta instalado con make install.
if [[ -f "$SCRIPT_DIR/lib/common.sh" ]]; then
    LIB_DIR="$SCRIPT_DIR/lib"
else
    LIB_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/vboxdisk/lib"
fi
if [[ ! -f "$LIB_DIR/common.sh" ]]; then
    printf 'vboxdisk: no se encontraron las bibliotecas en %s\n' "$LIB_DIR" >&2
    exit 1
fi
for _lib in common config state vbox storage cli apply queries; do
    # shellcheck disable=SC1090
    source "$LIB_DIR/$_lib.sh"
done
# shellcheck disable=SC2034  # lo lee cmd_apply en apply.sh.
GUEST_SCRIPT="$LIB_DIR/guest_ensure.sh"

# Al terminar por cualquier via se limpian los temporales del host y del invitado.
trap cleanup_tmps EXIT

# Analisis de la linea de comandos; valida la orden, sus opciones y el
# archivo declarativo solo cuando el manejador lo pide.
cli_parse "$@"

# Despacho de la orden al manejador correspondiente.
case "$CMD" in
    apply)
        cmd_apply
        ;;
    status)
        cmd_status
        ;;
    ld)
        cmd_ld "$LD_NAME"
        ;;
esac
