@startuml escenario

skinparam defaultFontName "Arimo"
skinparam dpi 150
skinparam componentStyle rectangle
skinparam nodesep 30
skinparam ranksep 45
skinparam wrapWidth 170
skinparam defaultTextAlignment center

node "Equipo host\nGNU/Linux" as HOST #E8F4FC {
  component "Solución en Bash\nvboxdisk · src/lib/ · vdisk.yml" as SOL #FFFFFF
  component "Interfaz de red\n(local)" as HNIC #FFFFFF
  component "Oracle VM VirtualBox 7.2\nhipervisor tipo 2 · VBoxManage" as VBox #FFFFFF
}

cloud "Red local\nmodo puente (bridged)" as LAN #E8F5E9

node "VM1\nGNU/Linux" as VM1 #FFF8E1 {
  component "Interfaz en puente" as NIC1 #FFFFFF
  component "Guest Additions\nVBoxService" as GA1 #FFFFFF
  database "Disco de datos 1 de VM1\n4 GiB · ext4 en /mnt/datos" as D1 #FFFFFF
  database "Disco de datos 2 de VM1\n1 GiB · ext4 en /mnt/respaldo" as D1B #FFFFFF
}

node "VM2\nGNU/Linux" as VM2 #FFF8E1 {
  component "Interfaz en puente" as NIC2 #FFFFFF
  component "Guest Additions\nVBoxService" as GA2 #FFFFFF
  database "Disco de datos de VM2\n3 GiB · xfs en /srv/datos" as D2 #FFFFFF
}

HNIC --> LAN : "medio físico"
LAN -[#E53935,dashed]-> NIC1 : "2. dirección IP\n(propiedad · ARP)"
LAN -[#E53935,dashed]-> NIC2

SOL -[#1E88E5,bold]-> VBox : "1. VBoxManage startvm"
VBox .[#1E88E5,bold].> GA1 : "3. guestcontrol run"
VBox .[#1E88E5,bold].> GA2
GA1 -[#43A047,bold]-> D1 : "4. lsblk · parted · mkfs\nmkdir · fstab · mount"
GA1 -[#43A047,bold]-> D1B
GA2 -[#43A047,bold]-> D2
VM1 .[#43A047,dashed].> VBox : "5. verificación\n(findmnt · df -h)"

@enduml
